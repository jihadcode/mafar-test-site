# Copy this file to a new file named ".env" (same folder) and fill in real
# values. ".env" is where secrets live — it's listed in .gitignore so it
# never gets committed/uploaded anywhere by accident.
#
#   cp .env.example .env        (Mac/Linux)
#   copy .env.example .env      (Windows Command Prompt)
#
# You do NOT need to fill in every value. Anything left blank just falls
# back to safe defaults (see README.md for what each fallback does).

# ---------------------------------------------------------------
# Session security
# ---------------------------------------------------------------
# A long, random string used to secure login sessions. Before this site
# goes live for real, set this to something random and unique — for
# example, run this in a terminal to generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "production" once actually deployed behind HTTPS. This makes
# login cookies HTTPS-only. Leave blank for local testing on http://localhost.
NODE_ENV=

# ---------------------------------------------------------------
# Email (optional) — powers the "Forgot Password" reset emails
# ---------------------------------------------------------------
# Leave ALL of these blank to keep the default behavior: reset links are
# printed to the server console instead of emailed. Fill them in to send
# real emails. See README.md → "Sending real emails" for provider-specific
# setup steps (Gmail, Brevo, Resend, etc).

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MAFAR-LDS Portal <no-reply@yourdomain.com>

# Where messages from the public Contact Us form get sent. Falls back to
# SMTP_USER if left blank.
CONTACT_EMAIL=
